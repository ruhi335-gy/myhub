<%- include('partials/head', {title: tool.name + ' - MyHub'}) %>
<%- include('partials/header') %>

<main class="container">
  <%- include('partials/searchbar') %>
  <p class="disclaimer-text">Disclaimer: This tool is provided for educational purposes only. Use at your own risk.</p>

  <div class="tool-detail">
    <img src="<%= tool.img %>" alt="<%= tool.name %>" class="tool-detail-img" onerror="this.src='https://placehold.co/600x350?text=No+Image'">
    <h1><%= tool.name %></h1>
    <p class="tool-description"><%= tool.description %></p>

    <% if (tool.commands && tool.commands.length > 0) { %>
    <div class="commands-section">
      <h3>Commands</h3>
      <% tool.commands.forEach(cmd => { %>
        <div class="command-box">
          <code><%= cmd %></code>
          <button class="copy-btn" onclick="copyCommand(this)">Copy</button>
        </div>
      <% }) %>
    </div>
    <% } %>

    <% if (tool.videoUrl) { %>
    <div class="video-section">
      <h3>Video Tutorial</h3>
      <div class="video-wrapper">
        <iframe src="<%= tool.videoUrl %>" frameborder="0" allowfullscreen></iframe>
      </div>
    </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
